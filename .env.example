# ==============================================================================
# 🌐 VELZION UNIFIED ENVIRONMENT VARIABLES
# ==============================================================================
# Save this file as '.env' in the root of your project.
# Both local and EC2 deployments will read from this single file.

# ------------------------------------------------------------------------------
# 1. EXTERNAL DATABASE (The architectural shift for shared state)
# Provide your external Postgres details here (e.g., Supabase, Neon, AWS RDS).
# Both Django and external tools will connect to this exact same database.
#
# ⚠️ CRITICAL SUPABASE / AWS EC2 FIX (Network Unreachable Error)
# Supabase's direct connection (db.YOUR_ID.supabase.co on port 5432) is IPv6-ONLY.
# Standard AWS EC2 instances do not route IPv6 by default, causing "Network is unreachable".
# YOU MUST use the Supabase "Connection Pooler" URL (Port 6543), which supports IPv4.
# It looks like: aws-0-[region].pooler.supabase.com
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://postgres.YOUR_ID:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres



# ------------------------------------------------------------------------------
# 2. DJANGO BACKEND SECRETS
# ------------------------------------------------------------------------------
# Any random string (used for cryptographic signing). DO NOT share your production key!
DJANGO_SECRET_KEY=velzion-insecure-key-for-local-dev-only
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your_ec2_ip
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://your_ec2_ip

# ------------------------------------------------------------------------------
# 3. GITHUB OAUTH CREDENTIALS
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# ------------------------------------------------------------------------------
# 4. AUTOMATION SECRETS
# ------------------------------------------------------------------------------
# Any random secure string used to verify webhook requests to Django
VELZION_WEBHOOK_SECRET=my-super-secret-webhook-key-123

# Your Personal Access Token for GitHub API (Required for PR comments)
GITHUB_PAT=your_github_personal_access_token_here

# ------------------------------------------------------------------------------
# 5. VELZION BACKEND ROUTING
# ------------------------------------------------------------------------------
# Required for OTLP Telemetry to ping back to your EC2 backend
# Replace with your EC2 public IP or domain (e.g., http://13.221.146.6:8000)
VELZION_PUBLIC_URL=http://your_ec2_ip:8000

# Note: We NO LONGER store AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY in this file!
# Velzion uses Enterprise IAM Role Binding via STS. The frontend UI will guide
# the user to create an IAM role via CloudFormation, which the backend will 
# assume dynamically per user.
# 7. FRONTEND VARIABLES (Passed during build/run)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
